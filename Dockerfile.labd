FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/gamebond-labd ./cmd/labd

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends iproute2 util-linux \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/gamebond-labd /usr/local/bin/gamebond-labd
ENTRYPOINT ["/usr/local/bin/gamebond-labd"]
