[Unit]
Description=GameBond FreeRADIUS server
After=network-online.target
Wants=network-online.target
Conflicts=freeradius.service radiusd.service

[Service]
Type=simple
User=freerad
Group=freerad
RuntimeDirectory=gamebond-radius
RuntimeDirectoryMode=0750
RuntimeDirectoryUser=freerad
RuntimeDirectoryGroup=freerad
ExecStart=/usr/sbin/freeradius -f -d /etc/gamebond/raddb -l stdout
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ReadWritePaths=/var/log/gamebond-radius /var/lib/gamebond-radius
ReadOnlyPaths=/etc/gamebond/raddb

[Install]
WantedBy=multi-user.target
